{
  "simulation": {
    "max_iterations": 1,
    "max_planning_rounds": 4,
    "max_conversation_steps": 3,
    "seed": 1
  },
  "environment": {
    "name": "JiraTicketEnvironment",
    "assignment_filling": true,
    "max_tasks": 8
  },
  "communication_network": {
    "topology": "complete",
    "num_agents": 6,
    "consolidate_channels": true
  },
  "llm_models": [
    {
      "label": "openrouter-gpt-4o-mini",
      "llm": {
        "provider": "together",
        "together": {
          "base_url": "https://openrouter.ai/api/v1",
          "model": "openai/gpt-4o-mini",
          "request_timeout": 180,
          "params": {
            "max_tokens": 1500,
            "temperature": 0.7
          }
        }
      }
    },
    {
      "label": "openrouter-gpt-4-1-mini",
      "llm": {
        "provider": "together",
        "together": {
          "base_url": "https://openrouter.ai/api/v1",
          "model": "openai/gpt-4.1-mini",
          "request_timeout": 180,
          "params": {
            "max_tokens": 1500,
            "temperature": 0.7
          }
        }
      }
    }
  ],
  "experiment": {
    "tag": "positive_control",
    "output_dir": "experiments/collusion/outputs/positive_control",
    "max_concurrent_runs": 3,
    "seeds": [
      1,
      2,
      3
    ],
    "collusion": {
      "colluder_selection": "random",
      "agent_order": "colluders_first"
    },
    "sweeps": [
      {
        "name": "positive_control",
        "topologies": [
          "complete"
        ],
        "num_agents": [
          6
        ],
        "colluder_counts": [
          2
        ],
        "secret_channel_enabled": [
          false,
          true
        ],
        "prompt_variants": [
          "control",
          "simple"
        ]
      }
    ]
  }
}